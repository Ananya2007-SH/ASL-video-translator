{
  "manifest_version": 3,
  "name": "AI Sign Language Translator for YouTube",
  "version": "1.0",
  "description": "Translates YouTube video captions into real-time AI sign language.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
